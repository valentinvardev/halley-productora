# Copiá este archivo como ".env" y completá los valores.
# Al agregar una variable acá, actualizá también el schema en "/src/env.js".

# ---- Base de datos (Supabase) -------------------------------------------
# DATABASE_URL: connection string del "Session pooler" (puerto 5432).
# DIRECT_URL:   conexión directa, la usa Prisma para las migraciones.
#
# Elegí el proyecto en South America (São Paulo): cada pantalla hace varias
# consultas y todas pagan el viaje de ida y vuelta hasta la base.
DATABASE_URL="postgresql://postgres:password@localhost:5432/halley-app"
DIRECT_URL="postgresql://postgres:password@localhost:5432/halley-app"

# Sólo para mudar la base de región — ver "Mudar la base de región" en el
# README. Fuera de esa mudanza va comentada.
# DATABASE_URL_DESTINO=""

# ---- Panel de administración --------------------------------------------
ADMIN_PASSWORD="halley2026"
ADMIN_EMAIL="admin@halleyproducciones.com"

# ---- Talo ----------------------------------------------------------------
# mock = CVU/alias generados localmente + simulador de transferencias.
# real = Customers API de Talo (requiere TALO_API_URL y TALO_API_KEY).
TALO_MODE="mock"
# TALO_API_URL="https://api.talo.com.ar"
# TALO_API_KEY=""

# ---- Mercado Pago --------------------------------------------------------
# mock = pantalla demo que imita Checkout Pro, sin plata real.
# real = preferencias contra la API de Mercado Pago.
# Ojo: con "real" hace falta que NEXT_PUBLIC_APP_URL sea una URL pública con
# HTTPS — el auto_return de MP rechaza localhost.
MP_MODE="mock"
#
# Credenciales de la APLICACIÓN de Halley (no de ningún socio). Habilitan el
# botón "Conectar Mercado Pago": cada socio autoriza desde su cuenta y su token
# llega solo, sin que nadie tenga que pasarlo por mensaje.
#
# Se sacan de mercadopago.com.ar/developers → Tus integraciones → tu app.
# Además hay que registrar ahí esta URL de redirección, exacta:
#   https://TU-DOMINIO/api/oauth/mercadopago
# MP_CLIENT_ID=""
# MP_CLIENT_SECRET=""

# ---- Demo ----------------------------------------------------------------
# "si" abre el simulador de transferencias, la confirmación de pagos falsos y
# el ingreso de familias sin verificar el email.
#
# SON PUERTAS ABIERTAS: con esto encendido cualquiera puede darse por pagado sin
# transferir y entrar a la cuenta de otro. Fuera de producción están disponibles
# igual; esta variable existe para poder mostrar la demo EN producción, a
# sabiendas. En un sistema con plata real, dejala sin definir.
# DEMO_ABIERTA="si"
#
# Cómo entran las familias: "enlace" manda un link de un solo uso al email (lo
# correcto). "directo" entra con sólo escribir el email — sólo para demo, y
# únicamente si además DEMO_ABIERTA="si".
# AUTH_PADRES="enlace"

# ---- Emails (Resend) -----------------------------------------------------
# bandeja = se registran en el panel sin enviarse (modo demo).
# resend  = además salen de verdad; requiere RESEND_API_KEY.
EMAIL_MODE="bandeja"
# RESEND_API_KEY="re_..."
# Hasta verificar el dominio en Resend, onboarding@resend.dev sólo puede
# escribirle a la casilla con la que creaste la cuenta.
EMAIL_FROM="Halley Producciones <onboarding@resend.dev>"
# A dónde llegan las respuestas cuando una familia contesta un aviso. El
# remitente suele ser una dirección del dominio verificado que no tiene casilla:
# sin esto, responder se pierde. Si no se define, se usa ADMIN_EMAIL.
# EMAIL_REPLY_TO="hola@halleyaudiovisual.com"

# ---- AWS S3 (contenido de la vitrina) ------------------------------------
# Todas opcionales: sin ellas la subida se apaga sola y la landing muestra las
# imágenes de relleno. AWS_S3_PREFIX es la carpeta de este cliente dentro del
# bucket — cambiala para aislar sus fotos de las de otro proyecto.
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-2"
# AWS_S3_BUCKET="mediaseller-photos"
# AWS_S3_PREFIX="halley"
# CloudFront delante del bucket: si está, el contenido se sirve por el CDN
# (cacheado en el borde, egress más barato) en vez de salir de S3 directo.
# CLOUDFRONT_DOMAIN="dxxxx.cloudfront.net"

# ---- App -----------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
